<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>virtual_control</name>
  <version>0.0.0</version>
  <description>
    OccupancyGrid/MIQP 상위 경로 계획, 고주기 QP-MPC 추종, 그리고
    VirtualControlCommand 및 MAVLink/Pixhawk 출력을 제공하는 계층형 제어 패키지
  </description>

  <maintainer email="fairytail0508@naver.com">eunhu</maintainer>
  <license>TODO: License declaration</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build & run dependencies -->
  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>imac_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>   <!-- ★ 추가된 부분 -->
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mavlink</depend>
  <depend>mpclib_vendor</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-pymavlink</exec_depend>

  <!-- Eigen (CMake 모듈) -->
  <build_depend>eigen3_cmake_module</build_depend>
  <exec_depend>eigen3_cmake_module</exec_depend>

  <!-- 테스트 의존성 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
