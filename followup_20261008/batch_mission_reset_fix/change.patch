+
+def recorded_start_grid():
+    import rosbag2_py
+    from rclpy.serialization import deserialize_message
+    from nav_msgs.msg import OccupancyGrid
+    if not (ROOT/'drive_batches/20261008_055617_scenario3_73cb2c/bag/metadata.yaml').exists():
