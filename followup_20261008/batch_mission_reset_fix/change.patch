+        'drive_batches/20261008_055617_scenario3_73cb2c/bag'), storage_id='mcap'),
+        rosbag2_py.ConverterOptions('', ''))
+    reader.set_filter(rosbag2_py.StorageFilter(topics=['/bev/occupancy_grid']))
